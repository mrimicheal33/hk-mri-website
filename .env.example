# Optional — enables /api/inquiry (Resend). The contact form uses FormSubmit
# directly from the browser when this is not set.
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM="HK MRI Instrument <info@mti-mill.com>"

# FormSubmit: first inquiry triggers a one-time activation email to
# michael.chan@mti-mill.com — click the link to enable delivery.

# Google Analytics 4 measurement ID (Admin → Data Streams → Web → Measurement ID)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
